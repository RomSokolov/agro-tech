generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Equipment {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  brand            String
  category         String
  condition        String
  price            Int
  year             Int
  horsepower       Int
  hours            Int?
  shortDescription String
  description      String
  images           String
  specs            String
  featured         Boolean  @default(false)
  inStock          Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([category])
  @@index([brand])
}

model Lead {
  id            String   @id @default(cuid())
  name          String
  email         String
  phone         String
  message       String?
  type          String   @default("general")
  status        String   @default("new")
  equipmentId   String?
  equipmentName String?
  createdAt     DateTime @default(now())

  @@index([status])
}
